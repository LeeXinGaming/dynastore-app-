# Recommended: use a Google OAuth client whose application type is Desktop app
GOOGLE_CLIENT_ID=your-desktop-client-id.apps.googleusercontent.com

# Compatibility mode for an existing Web application OAuth client.
# Add http://127.0.0.1:8765/ as an Authorized redirect URI in Google Cloud.
# Never commit the real client secret.
# GOOGLE_CLIENT_SECRET=your-rotated-secret
# GOOGLE_REDIRECT_URI=http://127.0.0.1:8765/
